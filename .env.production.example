# ===== Gestão TI — Tia Eliana — Ambiente de PRODUÇÃO =====
# Copie para .env na VM e preencha os valores reais.
# NUNCA reaproveite os valores do .env de desenvolvimento.

# ---- Banco de dados ----
POSTGRES_USER=gestao
# Gere uma senha forte só para produção, ex.: openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE-ESTA-SENHA-POR-UMA-FORTE
POSTGRES_DB=gestao_ti

# ---- API ----
# Segredo das sessões — gere um valor único e aleatório (NÃO reaproveite o de dev).
# No Linux: openssl rand -hex 48
JWT_SECRET=TROQUE-ESTE-SEGREDO-POR-UM-VALOR-ALEATORIO-DE-PRODUCAO
JWT_EXPIRES_IN=8h
UPLOAD_MAX_MB=15

# ---- Web ----
# Porta exposta pelo nginx no host da VM
WEB_PORT=8090

# URL que as PESSOAS realmente usam para acessar o sistema no dia a dia
# (rede interna da empresa — usada para montar os links de QR Code dos ativos).
# Exemplo: http://10.0.0.15:8090 ou http://gestao-ti.interno:8090
APP_URL=http://TROQUE-PELO-ENDERECO-INTERNO-DA-VM:8090

# ---- Integração WhatsApp (opcional) ----
# Deixe as três em branco para manter a integração inativa.
# Preencha seguindo docs/WHATSAPP_SETUP.md depois que o sistema já estiver no ar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Qualquer valor à sua escolha — o mesmo deve ser configurado no painel da Meta.
WHATSAPP_VERIFY_TOKEN=
