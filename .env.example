# ===== Gestão TI — Tia Eliana =====
# Copie este arquivo para .env e ajuste os valores.

# Banco de dados (PostgreSQL)
POSTGRES_USER=gestao
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gestao_ti
# Porta exposta no host pelo docker-compose (o container usa sempre 5432 internamente)
POSTGRES_PORT=5434

# URL usada pela API / Prisma.
# Rodando local (fora do Docker): host localhost e porta POSTGRES_PORT.
# Dentro do docker-compose a API usa o host "db" (já configurado no compose).
DATABASE_URL=postgresql://gestao:troque-esta-senha@localhost:5434/gestao_ti?schema=public

# API
API_PORT=3001
# Segredo do JWT — gere um valor longo e aleatório (ex.: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# Expiração da sessão
JWT_EXPIRES_IN=8h
# Diretório de anexos (volume persistente no Docker)
UPLOAD_DIR=./uploads
# Tamanho máximo de upload em MB
UPLOAD_MAX_MB=15

# Web (porta do nginx no docker-compose)
WEB_PORT=8090

# URL pública da aplicação (usada para montar links de QR Code)
APP_URL=http://localhost:8090

# ===== Integração WhatsApp (API oficial da Meta) — opcional =====
# Sem estas variáveis a integração fica inativa e nenhuma chamada externa é feita.
# Conversas iniciadas pelo usuário têm janela de serviço de 24h com respostas gratuitas.
# WHATSAPP_TOKEN=                # token permanente do app na Meta
# WHATSAPP_PHONE_NUMBER_ID=      # ID do número no WhatsApp Business
# WHATSAPP_VERIFY_TOKEN=         # valor livre — o mesmo configurado no webhook do painel da Meta
